msgid "Vocaloid 2 Sequence file"
msgstr "Vocaloid 2 Sequence ファイル"

msgid "Conversion plugin for Vocaloid 2 sequence file"
msgstr "Vocaloid 2 Sequence ファイル変換プラグイン"

