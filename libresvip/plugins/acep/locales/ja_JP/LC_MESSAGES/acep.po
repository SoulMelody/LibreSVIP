msgid "ACE Studio"
msgstr "ACE Studio"

msgid "ACE Studio project File"
msgstr "ACE Studio プロジェクトファイル"

msgid "Conversion Plugin for ACE Studio project file"
msgstr "ACE Studio プロジェクトファイル変換プラグイン"

msgid "yqzhishen"
msgstr "yqzhishen"

msgid "Unsupported project version"
msgstr "サポートされていないプロジェクトバージョン"

msgid "Chinese"
msgstr "中国語"

msgid "Japanese"
msgstr "日本語"

msgid "English"
msgstr "英語"

msgid "Spanish"
msgstr "スペイン語"

msgid "Korean"
msgstr "韓国語"

