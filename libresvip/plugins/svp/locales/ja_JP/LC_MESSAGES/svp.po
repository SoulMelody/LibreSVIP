msgid "Compatible with Synthesizer V Studio 1.9.0 and below"
msgstr "Synthesizer V Studio 1.9.0 以前と互換"

msgid "Compatible with Synthesizer V Studio 1.10.0 to 1.11.2"
msgstr "Synthesizer V Studio 1.10.0～1.11.2 と互換"

msgid "Compatible with Synthesizer V Studio 2.0 and up"
msgstr "Synthesizer V Studio 2.0 以降と互換"

