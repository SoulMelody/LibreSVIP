msgid "Auto determine by phonemizer language"
msgstr "Automatische Bestimmung anhand der Phonemizer-Sprache"

msgid "Monosyllabic languages: treating +, +~ and +* as slur notes"
msgstr "Einsilbige Sprachen: +, +~ und +* werden als Legato-Noten behandelt"

msgid "Polysyllabic languages: treating + as slur notes, and treating +~ or +* as syllable placeholders"
msgstr "Mehrsilbige Sprachen: + wird als Legato-Note behandelt, +~ oder +* als Silbenplatzhalter"

msgid "Incompatible with ARPAsing-series Phonemizers"
msgstr "Inkompatibel mit Phonemizern der ARPAsing-Serie"

msgid "Compatible with ARPAsing-series Phonemizers"
msgstr "Kompatibel mit Phonemizern der ARPAsing-Serie"

msgid "Plus sign handling mode"
msgstr "Modus für die Behandlung des Pluszeichens"

msgid "How to handle the + symbol in lyrics when importing USTX"
msgstr "Wie das +-Symbol in Liedtexten beim Import von USTX behandelt wird"

msgid "Breath lyrics"
msgstr "Atemtexte"

msgid "Special lyrics that will be recognized as breath notes only when immediately followed by a regular note, each separated by a space"
msgstr "Spezielle Texte, die nur als Atemnoten erkannt werden, wenn ihnen unmittelbar eine reguläre Note folgt, jeweils durch ein Leerzeichen getrennt"

msgid "Silence lyrics"
msgstr "Stille Texte"

msgid "Special lyrics that will be ignored, each separated by a space"
msgstr "Spezielle Texte, die ignoriert werden, jeweils durch ein Leerzeichen getrennt"

msgid "The way to handle english multisyllabic words"
msgstr "Die Art und Weise, englische mehrsilbige Wörter zu behandeln"

